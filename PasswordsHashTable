#include <cassert>
#include <cstdint>
#include <iomanip>
#include <iostream>
#include <list>
#include <string>
#include <utility>
#include <vector>

uint64_t demoHash(const std::string& s) {
    uint64_t h = 1469598103934665603ULL;
    for (unsigned char c : s) {
        h = (h ^ c) * 1099511628211ULL;
    }
    return h;
}

struct UserRecord {
    std::string username;
    std::string salt;
    uint64_t passwordHash = 0;
};

enum class Strategy { Chaining, Linear, Quadratic, DoubleHashing };

const char* strategyName(Strategy s) {
    switch (s) {
        case Strategy::Chaining: return "Separate chaining";
        case Strategy::Linear: return "Linear probing";
        case Strategy::Quadratic: return "Quadratic probing";
        case Strategy::DoubleHashing: return "Double hashing";
    }
    return "Unknown";
}

class HashTable {
    enum class State { Empty, Occupied, Deleted };
    struct Slot {
        UserRecord user;
        State state = State::Empty;
    };

    Strategy strategy;
    std::size_t capacity;
    std::size_t count = 0;
    std::size_t deletedCount = 0;
    std::size_t rehashes = 0;
    bool verbose;
    std::vector<std::list<UserRecord>> buckets;
    std::vector<Slot> slots;

    static bool isPrime(std::size_t n) {
        if (n < 2) return false;
        for (std::size_t d = 2; d <= n / d; ++d)
            if (n % d == 0) return false;
        return true;
    }

    static std::size_t nextPrime(std::size_t n) {
        if (n < 5) n = 5;
        while (!isPrime(n)) ++n;
        return n;
    }

    // A separate educational hash controls double hashing's step size.
    std::size_t stepFor(const std::string& key) const {
        uint64_t h = 5381;
        for (unsigned char c : key) h = h * 33 + c;
        return 1 + h % (capacity - 1);
    }

    std::size_t probe(std::size_t home, std::size_t step,
                      std::size_t i) const {
        if (strategy == Strategy::Quadratic)
            return (home + i * i) % capacity;
        if (strategy == Strategy::DoubleHashing)
            return (home + i * step) % capacity;
        return (home + i) % capacity;
    }

    // Internal insertion: caller has checked duplicates and capacity.
    bool place(const UserRecord& user) {
        const std::size_t home = demoHash(user.username) % capacity;
        if (strategy == Strategy::Chaining) {
            buckets[home].push_back(user);
            ++count;
            return true;
        }
        const std::size_t step = stepFor(user.username);
        for (std::size_t i = 0; i < capacity; ++i) {
            Slot& slot = slots[probe(home, step, i)];
            if (slot.state != State::Occupied) {
                if (slot.state == State::Deleted) --deletedCount;
                slot.user = user;
                slot.state = State::Occupied;
                ++count;
                return true;
            }
        }
        return false;
    }

    void rehash(std::size_t requestedCapacity) {
        HashTable rebuilt(strategy, requestedCapacity, verbose);
        if (strategy == Strategy::Chaining) {
            for (const auto& bucket : buckets)
                for (const auto& user : bucket) {
                    const bool placed = rebuilt.place(user);
                    assert(placed);
                    (void)placed;
                }
        } else {
            for (const auto& slot : slots)
                if (slot.state == State::Occupied) {
                    const bool placed = rebuilt.place(slot.user);
                    assert(placed);
                    (void)placed;
                }
        }
        if (verbose)
            std::cout << "  Rehash: " << capacity << " -> "
                      << rebuilt.capacity << " (" << count << " users moved)\n";
        buckets = std::move(rebuilt.buckets);
        slots = std::move(rebuilt.slots);
        capacity = rebuilt.capacity;
        deletedCount = 0;
        ++rehashes;
        // count stays unchanged: rehash moves users, not creates users.
    }

public:
    explicit HashTable(Strategy s = Strategy::Chaining,
                       std::size_t initialCapacity = 7, bool showRehash = true)
        : strategy(s), capacity(nextPrime(initialCapacity)), verbose(showRehash) {
        if (strategy == Strategy::Chaining) buckets.resize(capacity);
        else slots.resize(capacity);
    }

    std::size_t size() const { return count; }
    std::size_t bucketCount() const { return capacity; }
    std::size_t rehashCount() const { return rehashes; }
    double loadFactor() const {
        return static_cast<double>(count) / static_cast<double>(capacity);
    }

    // Returned pointer is read-only; do not retain it across table mutations.
    const UserRecord* find(const std::string& username) const {
        const std::size_t home = demoHash(username) % capacity;
        if (strategy == Strategy::Chaining) {
            for (const auto& user : buckets[home])
                if (user.username == username) return &user;
            return nullptr;
        }
        const std::size_t step = stepFor(username);
        for (std::size_t i = 0; i < capacity; ++i) {
            const Slot& slot = slots[probe(home, step, i)];
            if (slot.state == State::Empty) return nullptr;
            if (slot.state == State::Occupied && slot.user.username == username)
                return &slot.user;
            // Keep looking past Deleted: other keys may lie beyond it.
        }
        return nullptr;
    }

    // Reject duplicate usernames instead of silently replacing passwords.
    bool insert(const UserRecord& record) {
        if (find(record.username)) return false;
        UserRecord user = record; // Safe even if record aliases a table entry.
        const double limit = strategy == Strategy::Chaining ? 0.75 : 0.5;
        if (static_cast<double>(count + 1) / static_cast<double>(capacity) > limit)
            rehash(capacity * 2);
        else if (strategy != Strategy::Chaining &&
                 static_cast<double>(count + deletedCount + 1) /
                     static_cast<double>(capacity) > limit)
            rehash(capacity); // Remove tombstones without needless growth.

        // Defensive fallback; normal load/capacity rules guarantee space.
        while (!place(user)) rehash(capacity * 2);
        return true;
    }

    bool remove(const std::string& username) {
        const std::size_t home = demoHash(username) % capacity;
        if (strategy == Strategy::Chaining) {
            auto& bucket = buckets[home];
            for (auto it = bucket.begin(); it != bucket.end(); ++it) {
                if (it->username == username) {
                    bucket.erase(it);
                    --count;
                    return true;
                }
            }
            return false;
        }
        const std::size_t step = stepFor(username);
        for (std::size_t i = 0; i < capacity; ++i) {
            Slot& slot = slots[probe(home, step, i)];
            if (slot.state == State::Empty) return false;
            if (slot.state == State::Occupied && slot.user.username == username) {
                slot.user = UserRecord{};
                slot.state = State::Deleted; // Empty would break probe chains.
                --count;
                ++deletedCount;
                return true;
            }
        }
        return false;
    }
};

UserRecord makeUser(const std::string& username, const std::string& password,
                    const std::string& salt, const std::string& pepper) {
    return {username, salt, demoHash(salt + password + pepper)};
}

enum class LoginResult { Success, WrongPassword, UnknownUser };

LoginResult login(const HashTable& table, const std::string& username,
                  const std::string& submittedPassword, const std::string& pepper) {
    const UserRecord* user = table.find(username);
    if (!user) return LoginResult::UnknownUser;
    const uint64_t submittedHash = demoHash(user->salt + submittedPassword + pepper);
    return submittedHash == user->passwordHash
        ? LoginResult::Success : LoginResult::WrongPassword;
}

void showLogin(const HashTable& table, const std::string& username,
               const std::string& password, const std::string& pepper) {
    std::cout << "Login " << username << ": ";
    switch (login(table, username, password, pepper)) {
        case LoginResult::Success: std::cout << "SUCCESS\n"; break;
        case LoginResult::WrongPassword: std::cout << "FAILED PASSWORD\n"; break;
        case LoginResult::UnknownUser: std::cout << "UNKNOWN USER\n"; break;
    }
}

// Produce distinct keys with the SAME starting bucket to force collisions.
std::vector<std::string> collidingNames(std::size_t capacity, std::size_t amount) {
    std::vector<std::string> names;
    for (std::size_t i = 0; names.size() < amount; ++i) {
        std::string name = "user" + std::to_string(i);
        if (demoHash(name) % capacity == 0) names.push_back(name);
    }
    return names;
}

// Assertions verify behavior; mutations occur outside assert so release
// builds with NDEBUG still perform every operation.
void testStrategy(Strategy strategy, const std::string& pepper) {
    std::cout << "\nTesting " << strategyName(strategy) << '\n';
    HashTable table(strategy, 11);
    const auto names = collidingNames(11, 9);
    std::cout << "  Forced collisions (all initially hash to bucket 0):";
    for (std::size_t i = 0; i < 5; ++i) {
        std::cout << ' ' << names[i];
        bool inserted = table.insert(makeUser(names[i], "test-password",
                                              "salt-" + std::to_string(i), pepper));
        assert(inserted);
        (void)inserted;
    }
    std::cout << '\n';
    assert(table.size() == 5);
    assert(table.bucketCount() == 11);
    assert(table.loadFactor() == 5.0 / 11.0);
    for (std::size_t i = 0; i < 5; ++i)
        assert(login(table, names[i], "test-password", pepper) == LoginResult::Success);
    assert(login(table, names[0], "wrong", pepper) == LoginResult::WrongPassword);
    assert(login(table, "absent", "anything", pepper) == LoginResult::UnknownUser);

    bool duplicate = table.insert(makeUser(names[1], "different", "salt-x", pepper));
    assert(!duplicate && table.size() == 5);
    assert(login(table, names[1], "test-password", pepper) == LoginResult::Success);
    (void)duplicate;
    bool removed = table.remove(names[0]);
    assert(removed && !table.find(names[0]));
    (void)removed;
    // This specifically catches incorrect Empty marking during deletion.
    for (std::size_t i = 1; i < 5; ++i) assert(table.find(names[i]));
    bool absentRemoval = table.remove(names[0]);
    assert(!absentRemoval);
    (void)absentRemoval;

    // Exercises insertion after deletion, tombstone cleanup, and growth.
    for (std::size_t i = 5; i < names.size(); ++i) {
        bool inserted = table.insert(makeUser(names[i], "test-password",
                                              "salt-" + std::to_string(i), pepper));
        assert(inserted);
        (void)inserted;
    }
    bool reinserted = table.insert(makeUser(names[0], "new-password", "new-salt", pepper));
    assert(reinserted && table.size() == 9);
    (void)reinserted;
    assert(table.bucketCount() > 11 && table.rehashCount() > 0);
    for (std::size_t i = 1; i < names.size(); ++i)
        assert(login(table, names[i], "test-password", pepper) == LoginResult::Success);
    assert(login(table, names[0], "new-password", pepper) == LoginResult::Success);
    std::cout << "  Verified collision lookup, duplicate rejection, deletion,\n"
              << "  reinsertion, login, and preserved records after rehash.\n";
    for (const auto& name : names) {
        bool erased = table.remove(name);
        assert(erased);
        (void)erased;
    }
    assert(table.size() == 0 && table.loadFactor() == 0.0);
    assert(!table.find(names.back()));
}

int main(int argc, char* argv[]) {
    // Public fixture ONLY. A real pepper must be secret and stored separately.
    const std::string pepper = "CLASSROOM-PEPPER";
    std::cout << std::fixed << std::setprecision(3);
    for (Strategy s : {Strategy::Chaining, Strategy::Linear,
                       Strategy::Quadratic, Strategy::DoubleHashing})
        testStrategy(s, pepper);

    std::cout << "\nFINAL LOGIN TABLE: separate chaining\n";
    HashTable users; // Chaining, initially 7 buckets.
    users.insert(makeUser("austin", "BlueSky!1", "salt-A7", pepper));
    users.insert(makeUser("alice", "Ocean!2", "salt-B8", pepper));
    users.insert(makeUser("bob", "Forest!3", "salt-C9", pepper));
    users.insert(makeUser("carol", "Mountain!4", "salt-D0", pepper));
    users.insert(makeUser("david", "River!5", "salt-E1", pepper));
    std::cout << "Stored users: " << users.size()
              << ", load factor: " << users.loadFactor() << '\n';

    showLogin(users, "austin", "BlueSky!1", pepper);
    showLogin(users, "austin", "wrong-password", pepper);
    showLogin(users, "unknown", "anything", pepper);

    std::cout << "Adding a sixth user triggers automatic growth:\n";
    users.insert(makeUser("erin", "Sunrise!6", "salt-F2", pepper));
    std::cout << "After growth: " << users.size() << " users, "
              << users.bucketCount() << " buckets, load factor "
              << users.loadFactor() << '\n';
    showLogin(users, "austin", "BlueSky!1", pepper);
    std::cout << "Remove bob: " << (users.remove("bob") ? "REMOVED" : "NOT FOUND") << '\n';
    showLogin(users, "bob", "Forest!3", pepper);
    std::cout << "Users remaining: " << users.size() << '\n';

    // Optional interactive login: ./HashTable --interactive
    // Input is visible in this basic classroom terminal demonstration.
    if (argc > 1 && std::string(argv[1]) == "--interactive") {
        std::string username, password;
        std::cout << "\nUsername: ";
        if (!std::getline(std::cin, username)) return 0;
        std::cout << "Password (visible demo input): ";
        if (!std::getline(std::cin, password)) return 0;
        showLogin(users, username, password, pepper);
    }
}
